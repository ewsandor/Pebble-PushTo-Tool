{
  "name": "pebble-pushto-tool",
  "author": "Sandor Laboratories",
  "version": "0.5.1",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "PushTo Tool",
    "uuid": "0f463d47-47e7-46f1-a7d6-94590ffc001d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": ["location", "configurable"],
    "usesPermissions": [
      {
        "name": "Location",
        "reason": "To determine the observer's location and fetch local weather to correct for atmospheric refraction",
        "required": true
      }
    ],
    "messageKeys": [
      "JS_READY",
      "REQ_LOCATION",
      "LOC_LAT_E6",
      "LOC_LON_E6",
      "LOC_ALT_M",
      "LOC_ALT_VALID",
      "LOC_ACC_M",
      "LOC_SOURCE",
      "LOC_TIME",
      "LOC_ERROR",
      "WX_TEMP_DC",
      "WX_TEMP_UNIT",
      "WX_EXPIRES",
      "WX_CLEAR",
      "CFG_LABEL_MODE",
      "CFG_SHOW_TIME",
      "CFG_SHOW_EVENT",
      "CFG_SHOW_MAG",
      "CFG_USE_WEATHER",
      "CFG_PRECISION",
      "CFG_BANNER",
      "CFG_INVERT",
      "CFG_MIN_ELEV_ENABLED",
      "CFG_MIN_ELEV",
      "CFG_MAX_MAG_ENABLED",
      "CFG_MAX_MAG",
      "CFG_REFRACTION",
      "CFG_TINT",
      "CFG_FLASHLIGHT_ENABLED",
      "CFG_FLASHLIGHT_MIN",
      "TEST_CAPTURE"
    ],
    "resources": {
      "media": [
        {"type": "raw", "name": "CATALOG_PACK", "file": "generated/catalogs.bin"},
        {"type": "raw", "name": "EPHEMERIS_PACK", "file": "generated/ephemeris.bin"},
        {"type": "bitmap", "name": "APP_ICON", "file": "icons/app_icon.png", "menuIcon": true},
        {"type": "raw", "name": "ICON_LOCATION_25", "file": "icons/location_25.pdc", "targetPlatforms": ["emery", "gabbro"]},
        {"type": "raw", "name": "ICON_LOCATION_18", "file": "icons/location_18.pdc", "targetPlatforms": ["basalt", "chalk", "diorite", "flint"]},
        {"type": "raw", "name": "ICON_LOCATION_PROBLEM_25", "file": "icons/location_problem_25.pdc", "targetPlatforms": ["emery", "gabbro"]},
        {"type": "raw", "name": "ICON_LOCATION_PROBLEM_18", "file": "icons/location_problem_18.pdc", "targetPlatforms": ["basalt", "chalk", "diorite", "flint"]},
        {"type": "raw", "name": "ICON_WARNING_25", "file": "icons/warning_25.pdc", "targetPlatforms": ["emery", "gabbro"]},
        {"type": "raw", "name": "ICON_WARNING_18", "file": "icons/warning_18.pdc", "targetPlatforms": ["basalt", "chalk", "diorite", "flint"]},
        {"type": "raw", "name": "ICON_CLOCK_25", "file": "icons/alarm_clock_25.pdc", "targetPlatforms": ["emery", "gabbro"]},
        {"type": "raw", "name": "ICON_CLOCK_18", "file": "icons/alarm_clock_18.pdc", "targetPlatforms": ["basalt", "chalk", "diorite", "flint"]},
        {"type": "raw", "name": "ICON_FLASHLIGHT_25", "file": "icons/backlight_25.pdc", "targetPlatforms": ["emery", "gabbro"]},
        {"type": "raw", "name": "ICON_FLASHLIGHT_18", "file": "icons/backlight_18.pdc", "targetPlatforms": ["basalt", "chalk", "diorite", "flint"]}
      ]
    }
  }
}
